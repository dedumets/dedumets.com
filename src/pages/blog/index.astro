---
import IconRSS from "../../assets/icons/icon-rss.svg";
import BlogPost from "../../components/BlogPost.astro";
import Layout from "../../layouts/Root.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
	.filter((post) => !post.data.hidden)
	.sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf());
---

<Layout
	title="Blog"
	description="Personal opinions, progress updates, and anything else I feel like sharing from my daily life."
>
	<div class="heading">
		<h1>Blog</h1>
		<div class="rss">
			also available as&nbsp;
			<a href="/rss.xml">
				RSS
				<IconRSS width={16} height={16} fill="currentcolor" />
			</a>
		</div>
	</div>
	<section>
		<ul>
			{posts.map((post) => (
				<li>
					<BlogPost post={post} />
				</li>
			))}
		</ul>
	</section>
</Layout>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}

	.heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 2em;
	}

	.heading h1 {
		margin: 0;
	}

	.heading .rss {
		color: var(--secondary-foreground);
		text-align: right;
	}

	.heading .rss a {
		display: inline-block;
	}

	.heading .rss svg {
		margin-left: 0.25em;
	}

	@media (max-width: 720px) {
		ul {
			gap: 1em;
		}

		ul li {
			width: 100%;
			text-align: center;
		}
	}
</style>
