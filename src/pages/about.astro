---
import HeroImage from "../assets/blog/about.png";
import { LINK_RETROACHIEVEMENTS } from "../consts";
import Layout from "../layouts/Root.astro";
import { Image } from "astro:assets";
---

<Layout title="About" description="A little about myself" image={HeroImage}>
	<article>
		<div class="thumbnail">
			<Image width={600} height={300} src={HeroImage} alt="" />
		</div>
		<div class="prose">
			<div class="title">
				<h1>About</h1>
				<hr>
			</div>
			<p>
				I'm Lauris Patriks Dedumets, a software engineer based in Rīga, Latvia.
				I have a Bachelor's degree in Computer Science, and over 5 years of
				experience as a full-stack web developer. Most recently, I've been more
				involved with frontend development using Next.js and React Native.
			</p>
			<p>
				My free time also gets filled up with plenty of programming, whether it
				be small tools for personal use, or trying to build out fully-fledged
				products, but I, unfortunately, have nothing to show for it yet. I am,
				however, trying to work on this flaw of mine. You can be the judge of my
				success by reading my blog!
			</p>
			<p>
				Outside of development, I enjoy playing retro video games — you can find
				out more about what interests me on&nbsp;
				<a href={LINK_RETROACHIEVEMENTS} target="_blank" rel="noopener">
					RetroAchievements
				</a>
				&nbsp;— and I am recreationally learning music by playing both guitar
				and bass guitar. To stay fit, I participate in long-distance running,
				having completed 4 half-marathons, and currently training for my first
				full marathon.
			</p>
		</div>
	</article>
</Layout>
<style>
	.thumbnail {
		width: 100%;
	}

	.thumbnail img {
		display: block;
		margin: 0 auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}

	.prose {
		max-width: calc(100% - 1em);
		margin: auto;
		padding: 0.5em;
		color: var(--secondary);
	}

	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		text-align: center;
		line-height: 1;
	}

	.title h1 {
		margin: 0 0 0.5em 0;
	}
</style>
