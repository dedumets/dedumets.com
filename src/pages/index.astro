---
import BlogPost from "../components/BlogPost.astro";
import { LINK_BLUESKY, LINK_GITHUB, LINK_KOFI } from "../consts";
import Layout from "../layouts/Root.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
	.filter((post) => !post.data.hidden)
	.sort((a, b) => b.data.createdAt.valueOf() - a.data.createdAt.valueOf())
	.slice(0, 5);
---

<Layout
	title="Lauris Patriks"
	description="Personal website of Lauris Patriks Dedumets."
>
	<h1>Hi, I'm Lauris Patriks!</h1>
	<p>
		I am a software developer based in Rīga, Latvia. I like challenging myself,
		learning and improving my skills, both in my professional and personal life.
	</p>
	<p>
		This is my space to vent and to share whatever I'm working on. If you like
		what I say or do, you can:
	</p>
	<ul>
		<li>
			Hear more from me by following me on&nbsp;
			<a href={LINK_BLUESKY} target="_blank" rel="noopener">Bluesky</a>
		</li>
		<li>
			See more of my work by checking out my&nbsp;
			<a href={LINK_GITHUB} target="_blank" rel="noopener">GitHub</a>
		</li>
		<li>
			Support my work on&nbsp;
			<a href={LINK_KOFI} target="_blank" rel="noopener">Ko-Fi</a>
		</li>
	</ul>
	{!!posts.length && (
		<div class="blog">
			<hr>
			<h2>Blog</h2>
			<ul>
				{posts.map((post) => (
					<li>
						<BlogPost post={post} />
					</li>
				))}
			</ul>
			<div class="footer">
				<a href="/blog">see all posts ></a>
			</div>
		</div>
	)}
</Layout>

<style>
	.blog ul {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}

	.footer {
		margin-top: 1em;
		text-align: right;
	}

	@media (max-width: 720px) {
		.blog ul {
			gap: 1em;
		}

		.blog ul li {
			width: 100%;
			text-align: center;
		}
	}
</style>
