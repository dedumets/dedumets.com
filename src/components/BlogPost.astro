---
import FormattedDate from "./FormattedDate.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = { post: CollectionEntry<"blog"> };

const { post } = Astro.props;
---

<a href={`/blog/${post.id}`}>
	{post.data.thumbnail && (
		<Image width={500} height={250} src={post.data.thumbnail} alt="" />
	)}
	<div class="details">
		<div class="title">
			<h4>{post.data.title}</h4>
			<p class="date">
				<FormattedDate date={post.data.createdAt} />
			</p>
		</div>
		<p class="description">
			{post.data.description}
		</p>
	</div>
</a>

<style>
	a {
		display: flex;
		gap: 1em;
		text-decoration: none;
		transition: var(--transition-duration) var(--transition-function);
	}

	img {
		width: 240px;
		height: auto;
		margin-bottom: 0.5rem;
		border-radius: 12px;
	}

	h4 {
		margin: 0;
		color: var(--primary-foreground);
		font-size: 1.5rem;
	}

	.title {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-top: 8px;
		line-height: 1;
	}

	.date {
		margin: 0;
		color: var(--secondary-foreground);
	}

	.description {
		text-align: left;
		color: var(--secondary-foreground);
		margin: 16px 0 0;
		line-height: 1.25;
	}

	a:hover img,
	a:focus img {
		box-shadow: var(--box-shadow);
	}

	a:hover h4,
	a:hover .date,
	a:focus h4,
	a:focus .date {
		color: rgb(var(--accent-primary));
	}

	@media (max-width: 720px) {
		a {
			flex-direction: column;
			gap: 0;
		}

		img {
			width: 100%;
		}

		.title {
			margin: 0;
		}

		.description {
			margin: 8px 0 0;
			font-size: 0.9em;
			line-height: 1.2;
		}
	}
</style>
