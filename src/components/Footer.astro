---
import IconBluesky from "../assets/icons/icon-bluesky.svg";
import IconGitHub from "../assets/icons/icon-github.svg";
import IconKoFi from "../assets/icons/icon-kofi.svg";
import {
	LINK_BLUESKY,
	LINK_CC_BY,
	LINK_GITHUB,
	LINK_KOFI,
	LINK_MIT,
	LINK_REPOSITORY,
} from "../consts.ts";

const today = new Date();
---

<footer>
	<div class="copyright">
		<p>&copy; {today.getFullYear()} Lauris Patriks Dedumets</p>
		<p>
			Unless otherwise noted, content on this site is licensed under the&nbsp;
			<a href={LINK_CC_BY} target="_blank">CC-BY-4.0</a>&nbsp;license.
		</p>
		<p>
			Source code for the site is available on&nbsp;
			<a href={LINK_REPOSITORY} target="_blank">GitHub</a>&nbsp;under the&nbsp;
			<a href={LINK_MIT} target="_blank">MIT</a>&nbsp;license.
		</p>
	</div>
	<div class="socials">
		<a href={LINK_KOFI} target="_blank">
			<span class="sr-only">Support me on Ko-Fi</span>
			<IconKoFi aria-hidden width={32} height={32} fill="currentcolor" />
		</a>
		<a href={LINK_BLUESKY} target="_blank">
			<span class="sr-only">Follow me on BlueSky</span>
			<IconBluesky aria-hidden width={32} height={32} fill="currentcolor" />
		</a>
		<a href={LINK_GITHUB} target="_blank">
			<span class="sr-only">View my work on GitHub</span>
			<IconGitHub aria-hidden width={32} height={32} fill="currentcolor" />
		</a>
	</div>
</footer>
<style>
	.copyright p {
		margin: 0 1em;
	}

	.copyright {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
	}

	.socials a:hover,
	.socials a:focus {
		color: var(--primary-foreground);
	}

	.socials a {
		width: 32px;
		height: 32px;
		text-decoration: none;
		color: var(--secondary-foreground);
	}

	.socials {
		display: flex;
		justify-content: center;
		gap: 1em;
	}

	footer {
		display: flex;
		flex-direction: column;
		gap: 2em;
		padding: 2em 1em 4em 1em;
		background: linear-gradient(var(--background)) no-repeat;
		color: var(--secondary-foreground);
		text-align: center;

		& > * {
			max-width: var(--content-width);
			margin: 0 auto;
		}
	}
</style>
