---
import IconDedumets from "../assets/icons/icon-dedumets.svg";
---

<header>
	<nav>
		<h2>
			<a href="/">
				<IconDedumets width={96} fill="currentcolor" class="mobile-only" />
				<IconDedumets width={128} fill="currentcolor" class="desktop-only" />
			</a>
		</h2>
		<ul class="links">
			<li>
				<a href="/blog">Blog</a>
			</li>
			<li>
				<a href="/about">About</a>
			</li>
		</ul>
	</nav>
</header>
<style>
	header {
		padding: 0.5em 1em;
		background: var(--background-header);
		box-shadow: 0 2px 8px var(--black-shadow);
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}

	h2 {
		margin: 0;
		font-size: 1em;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--content-width);
		margin: 0 auto;
	}

	nav svg {
		transition: var(--transition-duration) var(--transition-function);
	}

	nav a {
		color: var(--foreground);
	}

	nav a:hover {
		color: var(--accent-secondary);
	}

	nav a:hover svg,
	nav a:focus svg {
		fill: var(--accent-secondary);
	}

	nav .links {
		display: flex;
		gap: 2rem;
	}

	nav ul {
		margin: 0;
		list-style-type: none;
	}
</style>
