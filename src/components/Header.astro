---
import IconDedumets from "../assets/icons/icon-dedumets.svg";
import HeaderLink from "./HeaderLink.astro";
---

<header>
	<nav>
		<h2>
			<a href="/">
				<IconDedumets width={96} fill="currentcolor" class="mobile-only" />
				<IconDedumets width={128} fill="currentcolor" class="desktop-only" />
			</a>
		</h2>
		<div class="links">
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	h2 a,
	h2 a.active {
		text-decoration: none;
	}

	h2 {
		margin: 0;
		font-size: 1em;
	}

	nav .links {
		display: grid;
		grid-template-columns: repeat(3, 8rem);
	}

	nav .links a.active {
		text-decoration: none;
		border-bottom-color: var(--accent-primary);
	}

	nav .links a:hover {
		background-color: var(--primary);
		border-bottom-color: var(--accent-secondary);
	}

	nav a {
		display: flex;
		justify-content: center;
		padding: 10px 0 6px;
		color: var(--foreground);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}

	nav svg {
		transition: var(--transition-duration) var(--transition-function);
	}

	nav svg:hover {
		fill: var(--accent-secondary);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--page-width);
		margin: 0 auto;
	}

	header {
		padding: 0 1em;
		background: var(--background-header);
		box-shadow: 0 2px 8px var(--black-shadow);
	}

	@media (max-width: 720px) {
		.links {
			grid-template-columns: repeat(3, 5rem);
		}

		header {
			padding-right: 0;
		}
	}
</style>
