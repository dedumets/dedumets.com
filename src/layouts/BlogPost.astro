---
import FormattedDate from "../components/FormattedDate.astro";
import Layout from "../layouts/Root.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"blog">["data"];

const { title, description, createdAt, updatedAt, thumbnail } = Astro.props;
---

<Layout title={title} description={description} image={thumbnail}>
	<article>
		<div class="thumbnail">
			{thumbnail && <Image width={1020} height={510} src={thumbnail} alt="" />}
		</div>
		<div class="prose">
			<div class="title">
				<div class="date">
					<FormattedDate date={createdAt} />
					{updatedAt && (
	<div class="updated-at">
		Last updated on <FormattedDate date={updatedAt} />
	</div>
)}
				</div>
				<h1>{title}</h1>
				<hr>
			</div>
			<slot />
		</div>
	</article>
</Layout>

<style>
	main {
		width: calc(100% - 2em);
		max-width: 100%;
		margin: 0;
	}
	.thumbnail {
		width: 100%;
	}
	.thumbnail img {
		display: block;
		margin: 0 auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.prose {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
		color: var(--secondary);
	}
	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		text-align: center;
		line-height: 1;
	}
	.title h1 {
		margin: 0 0 0.5em 0;
	}
	.date {
		margin-bottom: 0.5em;
		color: var(--secondary-foreground);
	}
	.updated-at {
		font-style: italic;
	}
</style>
